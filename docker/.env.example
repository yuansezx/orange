# 复制为 docker/.env 后按需修改
# 默认值与 config_example.yaml 对齐；本地开发建议换成随机口令，并同步配置文件。
POSTGRES_PASSWORD=orange-postgres

# 应用账号：首次初始化（空数据目录）时由 postgres/init.sh 创建
# 需与 config 里 core.persistence.connections.*.credentials 的 user / password / database 一致
POSTGRES_APP_USER=orange
POSTGRES_APP_PASSWORD=orange-postgres
POSTGRES_APP_DB=orange

REDIS_PASSWORD=orange-redis

RUSTFS_ACCESS_KEY=orange
RUSTFS_SECRET_KEY=orange-rustfs

# ---- 运行（docker-compose.yaml）----
# web 对外端口（宿主机）
WEB_PORT=8000
# 镜像名/标签：compose 启动用
ORANGE_APP_IMAGE=orange-app:nightly
ORANGE_WEB_IMAGE=orange-web:nightly
