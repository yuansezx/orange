# 复制为 web/.env 后按需覆盖；不建也能跑（默认值见 vite.config.ts）
# 这些值只影响 dev server / 构建，不会进入浏览器运行时。

# dev server 监听地址与端口
ORANGE_DEV_HOST=0.0.0.0
ORANGE_DEV_PORT=8000

# 后端 FastAPI 地址（与 config_example.yaml 的 core.port 对齐）
ORANGE_API_PROXY_TARGET=http://127.0.0.1:8100

# 目录链接模块真身路径（逗号分隔），Vite dev 的 fs.allow 兜底
# ORANGE_MODULE_ROOTS=E:/workstation/project/code/orange-tools
